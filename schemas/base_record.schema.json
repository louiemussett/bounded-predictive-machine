{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BaseRecord",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "created_at",
    "created_by",
    "loop_id",
    "status",
    "source_refs",
    "uncertainty"
  ],
  "properties": {
    "id": { "type": "string" },
    "record_type": { "type": "string" },
    "created_at": { "type": "string" },
    "created_by": { "type": "string" },
    "loop_id": { "type": ["string", "null"] },
    "status": { "type": "string" },
    "source_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "uncertainty": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
