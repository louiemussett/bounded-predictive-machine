{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryRetrievalRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "record_type", "created_at", "created_by", "loop_id", "status", "source_refs", "uncertainty", "query", "match_count", "matched_record_ids"],
  "properties": {
    "id": { "type": "string" },
    "record_type": { "const": "MemoryRetrievalRecord" },
    "created_at": { "type": "string" },
    "created_by": { "type": "string" },
    "loop_id": { "type": ["string", "null"] },
    "status": { "type": "string" },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": "array", "items": { "type": "string" } },
    "query": { "type": ["string", "null"] },
    "match_count": { "type": "integer" },
    "matched_record_ids": { "type": "array", "items": { "type": "string" } }
  }
}
