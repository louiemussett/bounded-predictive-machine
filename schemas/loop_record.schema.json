{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoopRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "record_type", "created_at", "created_by", "loop_id", "status", "source_refs", "uncertainty", "ordered_record_ids", "record_types"],
  "properties": {
    "id": { "type": "string" },
    "record_type": { "const": "LoopRecord" },
    "created_at": { "type": "string" },
    "created_by": { "type": "string" },
    "loop_id": { "type": ["string", "null"] },
    "status": { "type": "string" },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": "array", "items": { "type": "string" } },
    "ordered_record_ids": { "type": "array", "items": { "type": "string" } },
    "record_types": { "type": "array", "items": { "type": "string" } }
  }
}
